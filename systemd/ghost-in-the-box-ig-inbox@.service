[Unit]
Description=Read Instagram feed and comments for ghost-in-the-box account %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/ghost-in-the-box
ExecStart=%h/ghost-in-the-box/.venv/bin/python %h/ghost-in-the-box/scripts/ig_sync_inbox.py --account %i sync --posts 3 --pages 1 --threads 1 --feed-pages 1
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=3min
UMask=0077
