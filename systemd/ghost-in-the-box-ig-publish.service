[Unit]
Description=Deliver one queued Instagram ghost-in-the-box job
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/ghost-in-the-box
ExecStart=%h/ghost-in-the-box/.venv/bin/python %h/ghost-in-the-box/scripts/ig_publish_once.py
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=5min
UMask=0077
